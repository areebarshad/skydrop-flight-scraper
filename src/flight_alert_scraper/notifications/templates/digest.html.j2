<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Arial, sans-serif; color: #222; max-width: 600px; margin: 0 auto; }
  h2 { color: #7d6608; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0; }
  th, td { border: 1px solid #ddd; padding: 8px 10px; text-align: left; font-size: 14px; }
  th { background: #b7950b; color: white; }
  tr:nth-child(even) { background: #f5f5f5; }
  .note { font-size: 12px; color: #555; margin: 8px 0; }
</style>
</head>
<body>
<h2>Flight Digest: {{ ranked.query.origin }}→{{ ranked.query.destination }}</h2>
<p>No Tier 1 match found. Depart: <strong>{{ ranked.query.depart_date }}</strong></p>

{% if ranked.tier2 %}
<h3>Best Alternatives (Tier 2)</h3>
<table>
  <tr><th>Price</th><th>Duration</th><th>Stops</th><th>Labels</th><th>Note</th></tr>
  {% for m in ranked.tier2 %}
  <tr>
    <td>${{ "%.0f"|format(m.option.price_usd) }}</td>
    <td>{{ m.option.total_duration_minutes // 60 }}h {{ m.option.total_duration_minutes % 60 }}m</td>
    <td>{{ m.option.stops }}</td>
    <td>{{ m.labels | join(", ") }}</td>
    <td>{{ m.tradeoff_note }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% if ranked.tier3 %}
<h3>Baseline Options (Tier 3)</h3>
<table>
  <tr><th>Price</th><th>Duration</th><th>Stops</th><th>Labels</th><th>Note</th></tr>
  {% for m in ranked.tier3 %}
  <tr>
    <td>${{ "%.0f"|format(m.option.price_usd) }}</td>
    <td>{{ m.option.total_duration_minutes // 60 }}h {{ m.option.total_duration_minutes % 60 }}m</td>
    <td>{{ m.option.stops }}</td>
    <td>{{ m.labels | join(", ") }}</td>
    <td>{{ m.tradeoff_note }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<p class="note">Budget: ${{ ranked.query.constraints.max_price_usd }}
{% if ranked.query.constraints.max_duration_minutes %} | Max duration: {{ ranked.query.constraints.max_duration_minutes // 60 }}h{% endif %}
| {{ ranked.total_candidates }} candidates found</p>
</body>
</html>
